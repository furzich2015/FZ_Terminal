{
  "name": "fz-terminal",
  "version": "0.4.3",
  "description": "A minimal, high-functionality macOS-inspired desktop terminal",
  "author": {
    "name": "FZ Terminal contributors",
    "email": "furzich@users.noreply.github.com"
  },
  "desktopName": "fz-terminal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/furzich2015/FZ_Terminal.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "security:scan": "node scripts/security-scan.mjs",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "npm run rebuild",
    "icons:linux": "env -u ELECTRON_RUN_AS_NODE electron scripts/render-linux-icons.cjs",
    "prepare:native-assets": "node scripts/prepare-native-assets.cjs",
    "prepare:linux-release": "node scripts/prepare-linux-release.mjs",
    "prepare:macos-release": "node scripts/prepare-macos-release.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "package:linux": "npm run icons:linux && npm run build && electron-builder --linux AppImage deb && npm run prepare:linux-release",
    "release:linux": "npm run icons:linux && npm run build && electron-builder --linux AppImage deb --publish always && npm run prepare:linux-release",
    "package:windows": "npm run icons:linux && npm run build && electron-builder --win nsis --x64",
    "package:macos": "npm run icons:linux && npm run prepare:native-assets && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --x64 --arm64 --config.npmRebuild=false && npm run prepare:macos-release",
    "package:all": "npm run package:linux && npm run package:windows && npm run package:macos && npm run prepare:release",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "6.0.0",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "zustand": "^5.0.8"
  },
  "build": {
    "appId": "dev.furzich.fzterminal",
    "productName": "FZ Terminal",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "furzich2015",
        "repo": "FZ_Terminal",
        "releaseType": "release"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "artifactName": "FZ-Terminal-${version}-${arch}.${ext}",
    "linux": {
      "category": "Utility;TerminalEmulator",
      "executableName": "fz-terminal",
      "icon": "build/icons",
      "syncDesktopName": true,
      "synopsis": "A modern native terminal with workspaces, splits, and command blocks",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FZ Terminal"
    }
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
